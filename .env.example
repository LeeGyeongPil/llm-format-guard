# Only needed for examples/with_ollama.py (a real model). The library itself needs no key.
# OpenAI-compatible endpoint, for example a local Ollama server:
LFG_BASE_URL=
# Model name to send, for example one you pulled with `ollama pull`:
LFG_MODEL=
# Only for hosted endpoints that need a key. Leave empty for local Ollama.
LFG_API_KEY=
